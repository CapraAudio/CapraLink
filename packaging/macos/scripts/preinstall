#!/bin/sh
# remember the installed drivers, so postinstall restarts audio only if they change. Kept in the
# Installer's private per-install folder ($INSTALLER_TEMP), never a guessable /tmp path.
HAL=/Library/Audio/Plug-Ins/HAL
[ -d "$INSTALLER_TEMP" ] && shasum -a 256 "$HAL"/CapraLink*.driver/Contents/MacOS/* > "$INSTALLER_TEMP/capralink-drivers.before" 2>/dev/null
exit 0
