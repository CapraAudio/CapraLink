{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapraLink",
  "identifier": "com.capraaudio.capralink",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_PUBKEY",
      "endpoints": ["https://github.com/CapraAudio/CapraLink/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  }
}
